{
  "Django Form": {
    "prefix": "form",
    "body": [
      "class ${1:FormName}(forms.Form):",
      "\t${2:field_name} = forms.CharField(max_length=${3:255})",
      "",
      "\tdef clean(self):",
      "\t\tcleaned_data = super().clean()",
      "\t\t${4:# validation logic}",
      "\t\treturn cleaned_data",
      "$0"
    ],
    "description": "Django Form class"
  },
  "Django ModelForm": {
    "prefix": "modelform",
    "body": [
      "class ${1:ModelName}Form(forms.ModelForm):",
      "\tclass Meta:",
      "\t\tmodel = ${2:ModelName}",
      "\t\tfields = [${3:\"__all__\"}]",
      "\t\t${4:widgets = {\\}}",
      "$0"
    ],
    "description": "Django ModelForm class"
  },
  "Django clean_field": {
    "prefix": "clean_field",
    "body": [
      "def clean_${1:field_name}(self):",
      "\t${1} = self.cleaned_data.get(\"${1}\")",
      "\tif ${2:not $1}:",
      "\t\traise forms.ValidationError(\"${3:Invalid value.}\")",
      "\treturn ${1}",
      "$0"
    ],
    "description": "Django form clean_<field> method"
  },
  "Django clean": {
    "prefix": "clean",
    "body": [
      "def clean(self):",
      "\tcleaned_data = super().clean()",
      "\t${1:# cross-field validation}",
      "\treturn cleaned_data",
      "$0"
    ],
    "description": "Django form clean method"
  },
  "Django BooleanField (form)": {
    "prefix": "fbool",
    "body": "${1:FIELDNAME} = forms.BooleanField(${2:required=False})$0",
    "description": "Django form BooleanField"
  },
  "Django CharField (form)": {
    "prefix": "fchar",
    "body": "${1:FIELDNAME} = forms.CharField(max_length=${2:255}${3:, required=True})$0",
