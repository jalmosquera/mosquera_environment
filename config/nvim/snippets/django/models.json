      "\t${2:name} = models.CharField(max_length=${3:255})",
      "\tcreated_at = models.DateTimeField(auto_now_add=True)",
      "\tupdated_at = models.DateTimeField(auto_now=True)",
      "",
      "\tclass Meta:",
      "\t\tverbose_name = \"${4:$1}\"",
      "\t\tverbose_name_plural = \"${5:${4}s}\"",
      "\t\tordering = [\"${6:-created_at}\"]",
      "",
      "\tdef __str__(self):",
      "\t\treturn self.${2}",
      "$0"
    ],
    "description": "Django Model with timestamps, Meta, and __str__"
