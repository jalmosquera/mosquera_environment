{
  "Django urlpatterns": {
    "prefix": "urlpatterns",
    "body": [
      "urlpatterns = [",
      "\tpath(\"${1:}\", ${2:views.index}, name=\"${3:index}\"),",
      "]",
      "$0"
    ],
    "description": "Django urlpatterns list"
  },
  "Django path": {
    "prefix": "path",
    "body": "path(\"${1:route/}\", ${2:views.view_name}, name=\"${3:url_name}\"),$0",
    "description": "Django path"
  },
  "Django path with include": {
    "prefix": "pathinclude",
    "body": "path(\"${1:prefix/}\", include(\"${2:app_name}.urls\")),$0",
    "description": "Django path with include"
  },
  "Django re_path": {
    "prefix": "repath",
    "body": "re_path(r\"${1:^pattern/$}\", ${2:views.view_name}, name=\"${3:url_name}\"),$0",
    "description": "Django re_path"
  },
  "Django URL conf": {
    "prefix": "urlconf",
    "body": [
      "from django.urls import path",
      "",
      "from . import views",
      "",
      "app_name = \"${1:app_name}\"",
      "",
      "urlpatterns = [",
      "\tpath(\"\", views.${2:index}, name=\"${3:index}\"),",
      "]",
      "$0"
    ],
    "description": "Django full URL configuration file"
  },
  "Django app_name": {
    "prefix": "app_name",
    "body": "app_name = \"${1:app_name}\"$0",
    "description": "Django app_name for namespacing"
  },
  "Django DRF router": {
    "prefix": "drfrouter",
    "body": [
      "from rest_framework.routers import DefaultRouter",
      "from .views import ${1:ViewSetName}",
      "",
      "router = DefaultRouter()",
      "router.register(r\"${2:items}\", ${1:ViewSetName}, basename=\"${3:item}\")",
      "",
      "urlpatterns = router.urls",
      "$0"
    ],
    "description": "Django REST Framework router"
  }
}
