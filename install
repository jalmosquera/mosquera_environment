#!/usr/bin/env bash
# Mosquera Soft Environment installer. See README.md for usage.
set -euo pipefail

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PRESENTATION="$ROOT_DIR/lib/presentation.sh"
readonly TUI="$ROOT_DIR/lib/tui.sh"
readonly CATALOG="$ROOT_DIR/catalog/packages.toml"
readonly CHATSMANAGER_URL="https://github.com/jalmosquera/chatsManager.git"
readonly CHATSMANAGER_DIR="$HOME/.cheatsheets"
readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mosquera-soft"
readonly PROFILE_FILE="$STATE_DIR/profile"

PROFILE=""
DRY_RUN=false
CONFIGURE_FISH_ONLY=false
CHECK_SYSTEM_ONLY=false
VERBOSE=false
OS=""
DISTRO=""
ARCH=""
PKG_MANAGER=""
BACKUP_DIR=""
declare -a PACKAGES=()

[[ -r "$PRESENTATION" ]] || { printf 'Missing presentation module: %s\n' "$PRESENTATION" >&2; exit 1; }
# shellcheck disable=SC1090
source "$PRESENTATION"

usage() {
    cat <<'EOF'
Usage: ./install [profile] [--dry-run] [--verbose]

       ./install --configure-fish [--dry-run]
       ./install [profile] --check-system

Profiles: core, server, workstation, full
Without a profile, install prompts interactively.
EOF
}

info() { mosquera_ui_note "$*"; }
ok() { mosquera_ui_status ok installer "$*"; }
skip() { mosquera_ui_status skip installer "$*"; }
fail() { mosquera_ui_status fail installer "$*"; }
die() { fail "$*"; exit 1; }

run() {
    mosquera_ui_command installer "$@"
}

command_exists() { command -v "$1" >/dev/null 2>&1; }

refresh_user_paths() {
    if [[ -d "$HOME/.atuin/bin" ]]; then
        PATH="$HOME/.atuin/bin:$PATH"
        export PATH
    fi
}

select_profile() {
    if [[ -n "$PROFILE" ]]; then
        return
    fi

    if [[ ! -t 0 ]]; then
        PROFILE="core"
        mosquera_ui_note 'No interactive terminal detected; using profile core.'
        return
    fi

    printf 'Select profile [core/server/workstation/full] (default: core): '
    read -r PROFILE
    PROFILE="${PROFILE:-core}"
}

validate_profile() {
    case "$PROFILE" in
        core|server|workstation|full) ;;
        *) die "Unknown profile: $PROFILE" ;;
    esac
}

detect_platform() {
    OS="$(uname -s)"
    ARCH="$(uname -m)"

    case "$OS" in
        Darwin)
            DISTRO="macOS"
            PKG_MANAGER="brew"
            command_exists brew || die 'Homebrew is required on macOS. Install it first from https://brew.sh.'
            ;;
        Linux)
            [[ -r /etc/os-release ]] || die 'Cannot determine Linux distribution: /etc/os-release is missing.'
            # shellcheck disable=SC1091
            . /etc/os-release
            case "${ID:-}" in
                arch|manjaro|endeavouros)
                    DISTRO="${PRETTY_NAME:-Arch Linux}"
                    PKG_MANAGER="pacman"
                    ;;
                debian|ubuntu|linuxmint|pop)
                    DISTRO="${PRETTY_NAME:-Debian/Ubuntu}"
                    PKG_MANAGER="apt"
                    ;;
                *) die "Unsupported Linux distribution: ${PRETTY_NAME:-${ID:-unknown}}" ;;
            esac
            command_exists "$PKG_MANAGER" || die "Detected $DISTRO but $PKG_MANAGER is unavailable."
            ;;
        *) die "Unsupported operating system: $OS" ;;
    esac

    case "$ARCH" in
        arm64|aarch64|x86_64|amd64) ;;
        *) die "Unsupported architecture: $ARCH" ;;
    esac
}

preflight() {
    mosquera_ui_banner "$DISTRO" "$ARCH" "$PKG_MANAGER" "$PROFILE"
    mosquera_ui_section 'Preflight'

    command_exists git || die 'Git is required to install Mosquera Soft Environment.'
    command_exists curl || die 'curl is required to install Mosquera Soft Environment.'

    curl --fail --silent --show-error --head --max-time 10 https://github.com >/dev/null || die 'Network check failed: cannot reach GitHub.'

    [[ -w "$HOME" ]] || die "Home directory is not writable: $HOME"
    local available_kb
    available_kb="$(df -Pk "$HOME" | awk 'NR == 2 { print $4 }')"
    [[ "$available_kb" =~ ^[0-9]+$ ]] || die 'Could not determine free disk space.'
    (( available_kb >= 524288 )) || die 'At least 512 MiB of free space is required in HOME.'
    if "$MOSQUERA_UI_VERBOSE" || ! "$MOSQUERA_UI_DASHBOARD"; then
        ok "$DISTRO"
        ok "$ARCH"
        ok "Package manager: $PKG_MANAGER"
        ok 'Bootstrap tools: git, curl'
        ok 'Network: GitHub reachable'
        ok 'Requirements: writable home and at least 512 MiB free'
    fi
    mosquera_ui_complete_section preflight passed
}

check_system_only() {
    preflight
    if [[ "${MOSQUERA_TUI_SUPPRESS_UI:-false}" == true ]]; then
        printf 'OK %s\n' "$DISTRO"
        printf 'OK %s\n' "$ARCH"
        printf 'OK %s\n' "$PKG_MANAGER"
        printf '%s\n' 'OK git'
        printf '%s\n' 'OK curl'
        printf '%s\n' 'OK network'
        printf '%s\n' 'OK home'
        printf '%s\n' 'OK disk'
    fi
}

add_package() {
    local package="$1"
    local item
    for item in "${PACKAGES[@]:-}"; do
        if [[ "$item" == "$package" ]]; then
            return 0
        fi
    done
    PACKAGES+=("$package")
    return 0
}

resolve_profile() {
    local terminal=(curl git fish tmux fzf ripgrep fd bat less starship zoxide atuin carapace python3 python-venv)
    local development=(neovim nodejs build-tools github-cli tree lsd)
    local package

    for package in "${terminal[@]}" chats-manager; do
        add_package "$package"
    done

    if [[ "$PROFILE" == workstation || "$PROFILE" == full ]]; then
        for package in "${development[@]}"; do
            add_package "$package"
        done
    fi

    if [[ "$PROFILE" == full && "$OS" == Linux ]]; then
        if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
            add_package clipboard-wayland
        elif [[ -n "${DISPLAY:-}" ]]; then
            add_package clipboard-x11
        else
            skip 'clipboard: no graphical Linux session detected'
        fi
    fi
}

logical_command() {
    case "$1" in
        curl) printf 'curl' ;;
        git) printf 'git' ;;
        fish) printf 'fish' ;;
        tmux) printf 'tmux' ;;
        fzf) printf 'fzf' ;;
        ripgrep) printf 'rg' ;;
        fd) printf 'fd' ;;
        bat) printf 'bat' ;;
        less) printf 'less' ;;
        starship) printf 'starship' ;;
        zoxide) printf 'zoxide' ;;
        atuin) printf 'atuin' ;;
        carapace) printf 'carapace' ;;
        python3|python-venv) printf 'python3' ;;
        neovim) printf 'nvim' ;;
        nodejs) printf 'node' ;;
        build-tools) printf 'make' ;;
        github-cli) printf 'gh' ;;
        tree) printf 'tree' ;;
        lsd) printf 'lsd' ;;
        clipboard-wayland) printf 'wl-copy' ;;
        clipboard-x11) printf 'xclip' ;;
        *) return 1 ;;
    esac
}

is_installed() {
    local package="$1"
    case "$package" in
        python-venv) python3 -m ensurepip --version >/dev/null 2>&1 ;;
        build-tools)
            if [[ "$OS" == Darwin ]]; then
                xcode-select -p >/dev/null 2>&1
            else
                command_exists make
            fi
            ;;
        chats-manager) [[ -x "$CHATSMANAGER_DIR/install.sh" ]] ;;
        fd) command_exists fd || command_exists fdfind ;;
        bat) command_exists bat || command_exists batcat ;;
        atuin) command_exists atuin || [[ -x "$HOME/.atuin/bin/atuin" ]] ;;
        carapace) command_exists carapace || [[ -x "$HOME/.local/bin/carapace" ]] ;;
        *) command_exists "$(logical_command "$package")" ;;
    esac
}

package_name() {
    local package="$1"
    case "$PKG_MANAGER:$package" in
        brew:curl) printf 'curl' ;;
        pacman:curl|apt:curl) printf 'curl' ;;
        brew:git|pacman:git|apt:git) printf 'git' ;;
        brew:fish|pacman:fish|apt:fish) printf 'fish' ;;
        brew:tmux|pacman:tmux|apt:tmux) printf 'tmux' ;;
        brew:fzf|pacman:fzf|apt:fzf) printf 'fzf' ;;
        brew:ripgrep|pacman:ripgrep|apt:ripgrep) printf 'ripgrep' ;;
        brew:fd|pacman:fd) printf 'fd' ;;
        apt:fd) printf 'fd-find' ;;
        brew:bat|pacman:bat|apt:bat) printf 'bat' ;;
        brew:less|pacman:less|apt:less) printf 'less' ;;
        brew:starship|pacman:starship) printf 'starship' ;;
        brew:zoxide|pacman:zoxide|apt:zoxide) printf 'zoxide' ;;
        brew:atuin|pacman:atuin) printf 'atuin' ;;
        brew:carapace) printf 'carapace' ;;
        pacman:carapace) printf 'carapace-bin' ;;
        brew:python3) printf 'python' ;;
        pacman:python3) printf 'python' ;;
        apt:python3) printf 'python3' ;;
        apt:python-venv) printf 'python3-venv' ;;
        brew:neovim|pacman:neovim|apt:neovim) printf 'neovim' ;;
        brew:nodejs) printf 'node' ;;
        pacman:nodejs|apt:nodejs) printf 'nodejs' ;;
        pacman:build-tools) printf 'base-devel' ;;
        apt:build-tools) printf 'build-essential' ;;
        brew:github-cli) printf 'gh' ;;
        pacman:github-cli) printf 'github-cli' ;;
        apt:github-cli) printf 'gh' ;;
        brew:tree|pacman:tree|apt:tree) printf 'tree' ;;
        brew:lsd|pacman:lsd|apt:lsd) printf 'lsd' ;;
        pacman:clipboard-wayland|apt:clipboard-wayland) printf 'wl-clipboard' ;;
        pacman:clipboard-x11|apt:clipboard-x11) printf 'xclip' ;;
        *) return 1 ;;
    esac
}

install_native() {
    local package="$1"
    local name
    name="$(package_name "$package")" || return 1

    case "$PKG_MANAGER" in
        brew) run brew install "$name" ;;
        pacman) run sudo pacman -S --needed --noconfirm "$name" ;;
        apt) run sudo apt-get install -y "$name" ;;
    esac
}

install_official_carapace() {
    local carapace_arch archive extract_dir binary matches release_tag
    case "$ARCH" in
        x86_64|amd64) carapace_arch="amd64" ;;
        arm64|aarch64) carapace_arch="arm64" ;;
        *) die "Carapace has no official Linux release for $ARCH." ;;
    esac

    archive="$(mktemp)"
    extract_dir="$(mktemp -d)"
    run mkdir -p "$HOME/.local/bin"
    if "$DRY_RUN"; then
        run curl --fail --silent --show-error --location https://api.github.com/repos/carapace-sh/carapace-bin/releases/latest
        return 0
    fi
    if ! release_tag="$(curl --fail --silent --show-error --location --retry 3 --retry-all-errors https://api.github.com/repos/carapace-sh/carapace-bin/releases/latest | tr -d '\n' | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"; then
        mosquera_ui_status fail carapace 'could not resolve official release tag'
        return 1
    fi
    [[ -n "$release_tag" ]] || die 'Could not determine the latest official Carapace release.'
    run curl --fail --silent --show-error --location --retry 3 --retry-all-errors \
        "https://github.com/carapace-sh/carapace-bin/releases/download/${release_tag}/carapace-bin_${release_tag#v}_linux_${carapace_arch}.tar.gz" \
        -o "$archive"

    matches="$(tar -tzf "$archive" | grep -E '(^|/)carapace$' || true)"
    if [[ -z "$matches" || "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" != 1 ]]; then
        die 'Official Carapace release must contain exactly one carapace binary.'
    fi
    binary="$matches"
    mosquera_ui_command carapace tar -xzf "$archive" -C "$extract_dir" "$binary"
    mosquera_ui_command carapace install -m 0755 "$extract_dir/$binary" "$HOME/.local/bin/carapace"
    rm -f "$archive"
    rm -rf "$extract_dir"
    "$HOME/.local/bin/carapace" --version >/dev/null || die 'Installed Carapace did not run.'
    "$HOME/.local/bin/carapace" _carapace >/dev/null || die 'Installed Carapace cannot generate shell integration.'
}

install_special() {
    local package="$1"
    case "$package" in
        python-venv)
            case "$PKG_MANAGER" in
                brew|pacman) return 0 ;;
                apt)
                    local python_version
                    python_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
                    run sudo apt-get install -y "python${python_version}-venv"
                    ;;
            esac
            ;;
        build-tools)
            if [[ "$OS" == Darwin ]]; then
                if xcode-select -p >/dev/null 2>&1; then
                    return 0
                fi
                run xcode-select --install
                die 'Xcode Command Line Tools installation was requested. Re-run install after it completes.'
            fi
            install_native "$package"
            ;;
        starship)
            if package_name "$package" >/dev/null 2>&1; then
                install_native "$package"
            else
                run sh -c 'set -eu; installer=$(mktemp); trap "rm -f $installer" EXIT; curl --fail --silent --show-error --location --retry 3 --retry-all-errors https://starship.rs/install.sh -o "$installer"; sh "$installer" -y'
            fi
            ;;
        atuin)
            if package_name "$package" >/dev/null 2>&1; then
                install_native "$package"
            else
                run sh -c 'curl --proto "=https" --tlsv1.2 -LsSf https://setup.atuin.sh | sh -s -- --non-interactive'
                "$DRY_RUN" || refresh_user_paths
            fi
            ;;
        carapace)
            if package_name "$package" >/dev/null 2>&1; then
                install_native "$package"
            else
                case "$PKG_MANAGER" in
                    apt)
                        install_official_carapace
                        ;;
                    *) die "carapace has no installation method for $DISTRO yet." ;;
                esac
            fi
            ;;
        *) install_native "$package" ;;
    esac
}

install_dependencies() {
    mosquera_ui_section 'Dependencies'
    local package completed=0 total=0
    for package in "${PACKAGES[@]}"; do
        [[ "$package" != chats-manager ]] && total=$((total + 1))
    done
    local -a dependency_items=()
    for package in "${PACKAGES[@]}"; do
        [[ "$package" != chats-manager ]] && dependency_items+=("$package")
    done
    mosquera_ui_dashboard_start "$total" "${dependency_items[@]}"
    mosquera_ui_set_section dependencies checking
    for package in "${PACKAGES[@]}"; do
        if [[ "$package" == chats-manager ]]; then
            continue
        fi
        mosquera_ui_set_item "$package" checking checking
        if is_installed "$package"; then
            completed=$((completed + 1))
            mosquera_ui_complete_item "$package" already-installed 'already installed'
            mosquera_ui_progress "$completed" "$total" "$package"
            continue
        fi

        mosquera_ui_set_item "$package" installing installing
        if install_special "$package"; then
            completed=$((completed + 1))
            if "$DRY_RUN"; then
                mosquera_ui_complete_item "$package" skipped 'would install'
            else
                is_installed "$package" || die "$package installation did not provide the expected command."
                mosquera_ui_complete_item "$package" installed installed
            fi
            mosquera_ui_progress "$completed" "$total" "$package"
        else
            die "Failed to install $package."
        fi
    done
    mosquera_ui_complete_section dependencies "$completed/$total"
}

backup_path() {
    local path="$1"
    [[ -e "$path" || -L "$path" ]] || return 0
    [[ -n "$BACKUP_DIR" ]] || BACKUP_DIR="$HOME/.mosquera-soft/backups/$(date +%Y%m%d-%H%M%S)"
    run mkdir -p "$BACKUP_DIR"
    run mv "$path" "$BACKUP_DIR/$(basename "$path")"
    if "$DRY_RUN"; then
        mosquera_ui_status skip configuration "$path would be backed up"
    else
        mosquera_ui_status update configuration "backed up $path"
    fi
}

link_config() {
    local source="$1"
    local target="$2"
    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
        mosquera_ui_status ok configuration "$target already configured"
        return
    fi
    backup_path "$target"
    run mkdir -p "$(dirname "$target")"
    run ln -s "$source" "$target"
    if "$DRY_RUN"; then
        mosquera_ui_status skip configuration "$target would be linked"
    else
        mosquera_ui_status ok configuration "$target configured"
    fi
}

link_fish_config() {
    local fish_dir="$HOME/.config/fish"
    local path
    local entries=(config.fish conf.d functions completions themes)

    if [[ -L "$fish_dir" && "$(readlink "$fish_dir")" == "$ROOT_DIR/config/fish" ]]; then
        if "$DRY_RUN"; then
            mosquera_ui_status skip configuration "$fish_dir would be converted to a local directory"
            return 0
        fi
        local saved_state=""
        if [[ -f "$fish_dir/fish_variables" ]]; then
            saved_state="$(mktemp "$HOME/.config/fish_variables.XXXXXX")"
            cp "$fish_dir/fish_variables" "$saved_state"
        fi
        backup_path "$fish_dir"
        mkdir -p "$fish_dir"
        if [[ -n "$saved_state" ]]; then
            mv "$saved_state" "$fish_dir/fish_variables"
        fi
        mosquera_ui_status update configuration "$fish_dir converted to a local directory"
    elif [[ ! -d "$fish_dir" ]]; then
        run mkdir -p "$fish_dir"
    fi

    for path in "${entries[@]}"; do
        link_config "$ROOT_DIR/config/fish/$path" "$fish_dir/$path"
    done
}

configure_fish_only() {
    detect_platform
    mosquera_ui_banner "$DISTRO" "$ARCH" "$PKG_MANAGER" 'fish-only'
    mosquera_ui_section 'Configuring Fish'
    link_fish_config
}

configure_environment() {
    mosquera_ui_section 'Configuration'
    link_fish_config
    link_config "$ROOT_DIR/config/tmux/tmux.conf" "$HOME/.tmux.conf"
    link_config "$ROOT_DIR/config/starship/starship.toml" "$HOME/.config/starship.toml"

    if [[ "$PROFILE" == workstation || "$PROFILE" == full ]]; then
        link_config "$ROOT_DIR/config/nvim" "$HOME/.config/nvim"
    else
        mosquera_ui_status skip configuration 'Neovim configuration is not part of this profile'
    fi
    mosquera_ui_complete_section configuration configured
}

install_chats_manager() {
    mosquera_ui_section 'chatsManager'
    if [[ -e "$CHATSMANAGER_DIR" && ! -d "$CHATSMANAGER_DIR/.git" ]]; then
        die "$CHATSMANAGER_DIR exists but is not a Git repository; refusing to replace it."
    fi

    if [[ ! -e "$CHATSMANAGER_DIR" ]]; then
        run git clone --branch master "$CHATSMANAGER_URL" "$CHATSMANAGER_DIR"
        "$DRY_RUN" || mosquera_ui_status ok chatsManager 'repository cloned'
    else
        if [[ -n "$(git -C "$CHATSMANAGER_DIR" status --porcelain)" ]]; then
            mosquera_ui_status skip chatsManager 'repository has local changes; update skipped'
        else
            run git -C "$CHATSMANAGER_DIR" fetch origin master
            if "$DRY_RUN"; then
                mosquera_ui_status skip chatsManager 'repository would be fast-forwarded when possible'
            elif git -C "$CHATSMANAGER_DIR" merge-base --is-ancestor HEAD origin/master; then
                if [[ "$(git -C "$CHATSMANAGER_DIR" rev-parse HEAD)" == "$(git -C "$CHATSMANAGER_DIR" rev-parse origin/master)" ]]; then
                    mosquera_ui_status ok chatsManager 'repository already up to date'
                else
                    git -C "$CHATSMANAGER_DIR" merge --ff-only origin/master
                    mosquera_ui_status update chatsManager updated
                fi
            else
                mosquera_ui_status skip chatsManager 'repository diverged from origin/master; update skipped'
            fi
        fi
    fi

    run "$CHATSMANAGER_DIR/install.sh"
    "$DRY_RUN" || mosquera_ui_status ok chatsManager configured
    mosquera_ui_complete_section chatsManager configured
}

create_compatibility_links() {
    if [[ "$PKG_MANAGER" != apt ]]; then
        return 0
    fi
    local bin_dir="$HOME/.local/bin"
    if ! command_exists fd && command_exists fdfind; then
        run mkdir -p "$bin_dir"
        run ln -sfn "$(command -v fdfind)" "$bin_dir/fd"
        "$DRY_RUN" || mosquera_ui_status ok fd 'compatibility link configured'
    fi
    if ! command_exists bat && command_exists batcat; then
        run mkdir -p "$bin_dir"
        run ln -sfn "$(command -v batcat)" "$bin_dir/bat"
        "$DRY_RUN" || mosquera_ui_status ok bat 'compatibility link configured'
    fi
    return 0
}

verify() {
    mosquera_ui_section 'Verification'
    if "$DRY_RUN"; then
        mosquera_ui_status skip verification 'skipped in dry-run'
        return
    fi

    fish --no-execute "$HOME/.config/fish/config.fish" || die 'Fish configuration validation failed.'
    tmux -f "$HOME/.tmux.conf" start-server \; show-options -g default-terminal >/dev/null || die 'Tmux configuration validation failed.'
    fish -ic 'functions -q cs; and functions -q csfind' || die 'chatsManager Fish integration validation failed.'
    if [[ "$PROFILE" == workstation || "$PROFILE" == full ]]; then
        nvim --headless '+quitall' || die 'Neovim configuration validation failed.'
        node --version >/dev/null || die 'Node validation failed.'
    fi
    mosquera_ui_status ok verification 'installation verified'
    mosquera_ui_complete_section verification verified
}

record_profile() {
    run mkdir -p "$STATE_DIR"
    run sh -c 'printf "%s\n" "$1" > "$2"' sh "$PROFILE" "$PROFILE_FILE"
}

main() {
    local original_argc=$#
    while [[ $# -gt 0 ]]; do
        case "$1" in
            core|server|workstation|full)
                [[ -z "$PROFILE" ]] || die 'Specify only one profile.'
                PROFILE="$1"
                ;;
            --dry-run) DRY_RUN=true ;;
            --verbose) VERBOSE=true ;;
            --configure-fish) CONFIGURE_FISH_ONLY=true ;;
            --check-system) CHECK_SYSTEM_ONLY=true ;;
            -h|--help) usage; exit 0 ;;
            *) die "Unknown argument: $1" ;;
        esac
        shift
    done

    if (( original_argc == 0 )) && [[ -t 0 && -t 1 && "$CONFIGURE_FISH_ONLY" == false && "$CHECK_SYSTEM_ONLY" == false && -z "$PROFILE" ]]; then
        [[ -r "$TUI" ]] || die "TUI module missing: $TUI"
        # shellcheck disable=SC1090
        source "$TUI"
        mosquera_tui_main
        exit 0
    fi

    if [[ -z "$PROFILE" && ! -t 0 ]]; then
        die 'A profile is required when install is run without an interactive terminal.'
    fi

    if "$CONFIGURE_FISH_ONLY"; then
        [[ -z "$PROFILE" ]] || die '--configure-fish cannot be combined with a profile.'
        mosquera_ui_init install "$VERBOSE" "$DRY_RUN"
        configure_fish_only
        exit 0
    fi

    [[ -f "$CATALOG" ]] || die "Catalog missing: $CATALOG"
    select_profile
    validate_profile
    detect_platform
    mosquera_ui_init install "$VERBOSE" "$DRY_RUN"
    if "$CHECK_SYSTEM_ONLY"; then
        check_system_only
        exit 0
    fi
    preflight
    resolve_profile
    mosquera_ui_status info install "profile $PROFILE"
    install_dependencies
    create_compatibility_links
    configure_environment
    install_chats_manager
    verify
    record_profile
    "$DRY_RUN" || mosquera_ui_status ok install 'completed'
    mosquera_ui_finish_dashboard
}

main "$@"
